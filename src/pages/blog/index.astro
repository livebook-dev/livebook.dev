---
import { getCollection } from "astro:content";

import Layout from "../../layouts/Layout.astro";

import { formatDate } from "../../lib/utils.js";

const posts = (await getCollection("blog")).sort(
  (postA, postB) => postB.data.date - postA.data.date
);

const tags = [...new Set(posts.flatMap((post) => post.data.tags))].sort();
---

<Layout
  title="Blog"
  description="News, releases and tutorials from the team behind Livebook"
>
  <section id="intro">
    <div class="m-auto max-w-3xl px-4 pt-10">
      <h1 class="text-gray-900 text-3xl font-normal">Latest news</h1>
      <p class="mt-3 text-gray-700">
        News, releases and tutorials from the team behind Livebook.
      </p>
    </div>
  </section>

  <section id="posts">
    <div class="m-auto max-w-3xl px-4 pt-8 pb-20">
      <div data-el-tags class="flex flex-wrap gap-1">
        <button data-tag="all" class="button-tag button-tag-active">All</button>
        {
          tags.map((tag) => (
            <button data-tag={tag} class="button-tag">
              {tag}
            </button>
          ))
        }
      </div>

      <div class="mt-4 flex flex-col">
        {
          posts.map((post) => (
            <article
              data-tags={post.data.tags.join(",")}
              class="py-6 border-t border-gray-200"
            >
              <div class="flex flex-wrap items-center gap-x-2 text-sm text-gray-500">
                <time datetime={post.data.date.toISOString()}>
                  {formatDate(post.data.date)}
                </time>
                <span>·</span>
                <span>{post.data.author}</span>
                {post.data.tags.map((tag) => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
              <h2 class="mt-2 text-gray-900 text-xl font-semibold">
                <a class="hover:text-blue-700" href={`/blog/${post.id}`}>
                  {post.data.title}
                </a>
              </h2>
              <p class="mt-2 text-gray-700">{post.data.description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</Layout>

<style>
  @reference "../../styles/base.css";

  .button-tag {
    @apply px-3 py-1 rounded-lg text-sm text-gray-600 hover:bg-gray-100;
  }

  .button-tag-active {
    @apply bg-gray-200 text-gray-900;
  }

  .tag {
    @apply px-2 py-0.5 rounded-md bg-gray-100 text-xs text-gray-600;
  }
</style>

<script>
  const tagsEl = document.querySelector("[data-el-tags]");

  function setActiveTag(tag) {
    for (const article of document.querySelectorAll("article[data-tags]")) {
      const tags = article.dataset.tags.split(",");
      article.classList.toggle("hidden", tag !== "all" && !tags.includes(tag));
    }

    for (const button of tagsEl.querySelectorAll("button[data-tag]")) {
      button.classList.toggle("button-tag-active", button.dataset.tag === tag);
    }

    const url = new URL(window.location.href);

    if (tag === "all") {
      url.searchParams.delete("tag");
    } else {
      url.searchParams.set("tag", tag);
    }

    window.history.replaceState(null, "", url);
  }

  tagsEl.addEventListener("click", (event) => {
    const button = event.target.closest("button[data-tag]");

    if (button) {
      setActiveTag(button.dataset.tag);
    }
  });

  const tag = new URL(window.location.href).searchParams.get("tag");

  if (tag) {
    setActiveTag(tag);
  }
</script>
