---
import SmartCell from "./SmartCell.astro";
import SmartCellHeader from "./SmartCellHeader.astro";
import SmartCellRow from "./SmartCellRow.astro";
import Field from "./Field.astro";
import Input from "./Input.astro";
import hfLogo from "../../images/integrations/hugging-face/logo.png";

interface Props {
  task: string;
  model: string;
  params: { label: string; value?: string; select?: boolean; class?: string }[];
  /** Some tasks show an explanatory note below the parameters */
  note?: string;
}

const { task, model, params, note } = Astro.props;
---

<SmartCell>
  <SmartCellHeader slot="header" help>
    <Field label="Task" inline>
      <Input value={task} select class="w-56" />
    </Field>
    <Field label="Using" inline>
      <Input value={model} select class="w-72" />
    </Field>
    <img class="h-5 w-5 object-contain" src={hfLogo.src} alt="Hugging Face" />
  </SmartCellHeader>
  <SmartCellRow>
    {
      params.map((param) => (
        <Field label={param.label} class={param.class ?? "w-44"}>
          <Input value={param.value} select={param.select} />
        </Field>
      ))
    }
  </SmartCellRow>
  {
    note && (
      <SmartCellRow>
        <p class="text-sm text-gray-700">
          <span class="font-semibold">Note:</span> {note}
        </p>
      </SmartCellRow>
    )
  }
</SmartCell>
