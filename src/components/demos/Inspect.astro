---
interface Props {
  /** Text as printed by `inspect/2`, tokens are colored automatically */
  text: string;
  class?: string;
}

const { text, class: className } = Astro.props;

// Livebook configures `inspect` with these colors, see
// Livebook.Runtime.Evaluator.Formatter.syntax_colors/0. The hex values are
// the ANSI colors from Livebook's assets/css/ansi.css
const blue = "text-[#4078f2]";
const green = "text-[#50a14f]";
const magenta = "text-[#a726a4]";
const red = "text-[#ca1243]";

const patterns: [RegExp, string | null][] = [
  // Inspected structs without a literal representation stay uncolored
  [/#[A-Za-z]+<[^>]*>/y, null],
  [/"(?:[^"\\]|\\.)*"/y, green],
  [/~r\/(?:[^/\\]|\\.)*\/[a-z]*/y, red],
  [/\b(?:true|false|nil)\b/y, magenta],
  [/:(?:"(?:[^"\\]|\\.)*"|[a-zA-Z_][a-zA-Z0-9_@]*[?!]?)/y, blue],
  [/[a-zA-Z_][a-zA-Z0-9_@]*[?!]?:/y, blue],
  [/\d[\d_]*(?:\.\d+)?(?:e[+-]?\d+)?/y, blue],
];

interface Token {
  text: string;
  class: string | null;
}

function tokenize(text: string): Token[] {
  const tokens: Token[] = [];
  let idx = 0;
  let plain = "";

  const push = (token: Token) => {
    if (plain) {
      tokens.push({ text: plain, class: null });
      plain = "";
    }
    tokens.push(token);
  };

  while (idx < text.length) {
    let matched = false;

    for (const [regex, className] of patterns) {
      regex.lastIndex = idx;
      const match = regex.exec(text);

      if (match) {
        push({ text: match[0], class: className });
        idx = regex.lastIndex;
        matched = true;
        break;
      }
    }

    if (!matched) {
      plain += text[idx];
      idx += 1;
    }
  }

  if (plain) tokens.push({ text: plain, class: null });

  return tokens;
}

const tokens = tokenize(text);
---

<div
  class:list={[
    "whitespace-pre-wrap font-mono text-[14px] leading-[1.4] text-gray-500",
    className,
  ]}
>
  {
    tokens.map((token) =>
      token.class ? <span class={token.class}>{token.text}</span> : token.text,
    )
  }
</div>
