---
import FeatureFrame from "../FeatureFrame.astro";
import NeuralNetworkCell from "../NeuralNetworkCell.astro";
import CellIndicator from "../CellIndicator.astro";
import Output from "../Output.astro";
import KinoInput from "../KinoInput.astro";
import Button from "../Button.astro";
---

<FeatureFrame zoom={1.5}>
  <NeuralNetworkCell
    task="Text generation"
    model="GPT2 (base)"
    params={[
      { label: "Max input tokens", value: "100" },
      { label: "Min new tokens" },
      { label: "Max new tokens", value: "14" },
      { label: "Compiler", value: "EXLA", select: true },
    ]}
  />
  <div class="mt-2 flex justify-end">
    <CellIndicator status="evaluated" language="elixir" light />
  </div>
  <Output>
    <div class="flex flex-col gap-3">
      <KinoInput label="Text" value="Elixir is a functional" textarea />
      <div><Button>Run</Button></div>
      <div class="text-gray-700">
        Elixir is a functional programming language that is designed to be used
        in a variety of applications.
      </div>
    </div>
  </Output>
</FeatureFrame>
