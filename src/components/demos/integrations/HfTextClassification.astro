---
import FeatureFrame from "../FeatureFrame.astro";
import NeuralNetworkCell from "../NeuralNetworkCell.astro";
import CellIndicator from "../CellIndicator.astro";
import Output from "../Output.astro";
import KinoInput from "../KinoInput.astro";
import Button from "../Button.astro";
import ScoreBars from "../ScoreBars.astro";
---

<FeatureFrame zoom={1.3}>
  <NeuralNetworkCell
    task="Text classification"
    model="RoBERTa (BERTweet) - emotion"
    params={[
      { label: "Top-k" },
      { label: "Max input tokens", value: "100" },
      { label: "Compiler", value: "EXLA", select: true },
    ]}
  />
  <div class="mt-2 flex justify-end">
    <CellIndicator status="evaluated" language="elixir" light />
  </div>
  <Output>
    <div class="flex flex-col gap-3">
      <KinoInput label="Text" value="Oh wow, I didn't know that!" textarea />
      <div><Button>Run</Button></div>
      <ScoreBars
        scores={[
          { label: "surprise", score: 0.988 },
          { label: "others", score: 0.003 },
          { label: "joy", score: 0.002 },
          { label: "anger", score: 0.002 },
          { label: "fear", score: 0.002 },
        ]}
      />
    </div>
  </Output>
</FeatureFrame>
