---
import FeatureFrame from "../FeatureFrame.astro";
import NeuralNetworkCell from "../NeuralNetworkCell.astro";
import CellIndicator from "../CellIndicator.astro";
import Output from "../Output.astro";
import Button from "../Button.astro";
import AudioPlayer from "../AudioPlayer.astro";
---

<FeatureFrame zoom={1.45}>
  <NeuralNetworkCell
    task="Speech-to-text"
    model="Whisper (tiny multilingual)"
    params={[
      { label: "Max new tokens", value: "100" },
      { label: "Compiler", value: "EXLA", select: true },
    ]}
  />
  <div class="mt-2 flex justify-end">
    <CellIndicator status="evaluated" language="elixir" light />
  </div>
  <Output>
    <div class="flex flex-col gap-3">
      <div>
        <div class="mb-1 text-sm text-gray-800 font-medium">Audio</div>
        <div
          class="inline-block p-3 rounded-lg border border-dashed border-gray-300"
        >
          <AudioPlayer />
        </div>
      </div>
      <div><Button>Run</Button></div>
      <div class="text-gray-700">Tell me about it.</div>
    </div>
  </Output>
</FeatureFrame>
