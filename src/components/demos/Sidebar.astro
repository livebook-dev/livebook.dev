---
import Icon from "../Icon.astro";
import logo from "../../images/logo.svg";

interface Props {
  /** Initials shown in the user avatar */
  initials?: string;
  /** Background color of the user avatar */
  color?: string;
}

const { initials = "JK", color = "#6583ff" } = Astro.props;

const icons = [
  "node-tree",
  "group-fill",
  "cpu-line",
  "lock-password-line",
  "folder-open-fill",
  "rocket-line",
];
---

<nav
  class="w-16 shrink-0 flex flex-col items-center px-3 py-5 gap-3 bg-gray-900"
  aria-hidden="true"
>
  <img class="w-10 h-10" src={logo.src} alt="" />
  {
    icons.map((icon) => (
      <span class="h-10 w-10 flex items-center justify-center text-2xl text-gray-400">
        <Icon icon={icon} />
      </span>
    ))
  }
  <div class="grow"></div>
  <span
    class="h-10 w-10 flex items-center justify-center text-2xl text-gray-400"
  >
    <Icon icon="delete-bin-6-fill" />
  </span>
  <span
    class="h-10 w-10 flex items-center justify-center text-2xl text-gray-400"
  >
    <Icon icon="keyboard-box-fill" />
  </span>
  <div
    class="mt-2 h-8 w-8 rounded-full flex items-center justify-center text-xs font-semibold text-gray-100"
    style={`background-color: ${color}`}
  >
    {initials}
  </div>
</nav>
