---
import FeatureFrame from "./FeatureFrame.astro";
import Editor from "./Editor.astro";

interface Props {
  /** Value of LIVEBOOK_IDENTITY_PROVIDER, see the Livebook authentication docs */
  identityProvider: string;
  name: string;
}

const { identityProvider, name } = Astro.props;

const code = `docker run -p 8080:8080 -p 8081:8081 --pull always \\
  -e LIVEBOOK_PASSWORD="securesecret" \\
  -e LIVEBOOK_IDENTITY_PROVIDER="${identityProvider}" \\
  ghcr.io/livebook-dev/livebook`;
---

<FeatureFrame height={450} zoom={1.3} class="p-8">
  <h3 class="text-xl font-semibold text-gray-800">
    Run Livebook behind {name}
  </h3>
  <p class="mt-3 text-gray-700">
    Set the <code
      class="px-1 py-0.5 rounded bg-gray-100 font-mono text-[0.9em] text-gray-800"
      >LIVEBOOK_IDENTITY_PROVIDER</code
    > environment variable and every route of your instance is protected.
  </p>
  <div class="mt-6">
    <Editor code={code} lang="shell" gutter={false} class="px-4" />
  </div>
</FeatureFrame>
