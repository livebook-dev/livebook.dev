---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;

// Mermaid's default theme
const fill = "#ececff";
const stroke = "#9370db";
const text = "#333333";
const labelBackground = "#e8e8e8";
---

<svg
  class={className}
  viewBox="0 0 762 202"
  width="762"
  height="202"
  font-family="Inter, sans-serif"
  font-size="15"
>
  <defs>
    <marker
      id="mermaid-arrow"
      viewBox="0 0 10 10"
      refX="9"
      refY="5"
      markerWidth="6"
      markerHeight="6"
      orient="auto-start-reverse"
    >
      <path d="M 0 0 L 10 5 L 0 10 z" fill={text}></path>
    </marker>
  </defs>

  <g
    stroke={text}
    stroke-width="1.5"
    marker-end="url(#mermaid-arrow)"
    fill="none"
  >
    <path d="M 121 101 L 249 101"></path>
    <path d="M 381 101 L 429 101"></path>
    <path d="M 543 72 L 580 43 L 629 43"></path>
    <path d="M 543 130 L 580 159 L 629 159"></path>
  </g>

  <rect x="1" y="79" width="120" height="44" fill={fill} stroke={stroke}></rect>
  <text
    x="61"
    y="101"
    text-anchor="middle"
    dominant-baseline="central"
    fill={text}
  >
    Hard edge
  </text>

  <rect x="149" y="90" width="72" height="22" fill={labelBackground}></rect>
  <text
    x="185"
    y="101"
    text-anchor="middle"
    dominant-baseline="central"
    fill={text}
  >
    Link text
  </text>

  <rect
    x="249"
    y="79"
    width="132"
    height="44"
    rx="22"
    fill={fill}
    stroke={stroke}></rect>
  <text
    x="315"
    y="101"
    text-anchor="middle"
    dominant-baseline="central"
    fill={text}
  >
    Round edge
  </text>

  <path d="M 491 41 L 551 101 L 491 161 L 431 101 Z" fill={fill} stroke={stroke}
  ></path>
  <text
    x="491"
    y="101"
    text-anchor="middle"
    dominant-baseline="central"
    fill={text}
  >
    Decision
  </text>

  <rect x="562" y="32" width="42" height="22" fill={labelBackground}></rect>
  <text
    x="583"
    y="43"
    text-anchor="middle"
    dominant-baseline="central"
    fill={text}>One</text
  >
  <rect x="562" y="148" width="44" height="22" fill={labelBackground}></rect>
  <text
    x="584"
    y="159"
    text-anchor="middle"
    dominant-baseline="central"
    fill={text}>Two</text
  >

  <rect x="631" y="21" width="130" height="44" fill={fill} stroke={stroke}
  ></rect>
  <text
    x="696"
    y="43"
    text-anchor="middle"
    dominant-baseline="central"
    fill={text}
  >
    Result one
  </text>

  <rect x="631" y="137" width="130" height="44" fill={fill} stroke={stroke}
  ></rect>
  <text
    x="696"
    y="159"
    text-anchor="middle"
    dominant-baseline="central"
    fill={text}
  >
    Result two
  </text>
</svg>
